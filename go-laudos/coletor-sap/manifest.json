{
  "manifest_version": 3,
  "name": "GO - LAUDOS · Coletor SAP",
  "version": "0.34.0",
  "description": "Sincronização SAP de 01.01.2026 até ontem, com confirmação de processamento e envio ao GO - LAUDOS.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "unlimitedStorage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://go-laudos.netlify.app/*",
    "https://s4.sipal.com.br/*",
    "https://login.microsoftonline.com/*",
    "https://zdqugqdpnadubfxvefme.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://s4.sipal.com.br/*"
      ],
      "js": [
        "selection.js",
        "collector.js",
        "auto-scroll.js",
        "runner.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://login.microsoftonline.com/*"
      ],
      "js": [
        "login.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://go-laudos.netlify.app/*"
      ],
      "js": [
        "agenda-bridge.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://s4.sipal.com.br/*"
      ],
      "js": [
        "home-search.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "120"
}
